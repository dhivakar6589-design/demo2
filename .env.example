# ─────────────────────────────────────────────────────────────
# Aurelia — environment configuration
# Copy to `.env` and fill in. Every value below has a safe
# development default, so `npm run db:reset && npm run dev`
# boots with zero configuration.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Development uses SQLite (file:./dev.db). No server required.
DATABASE_URL="file:./dev.db"
# Production target — PostgreSQL 14+ (see docs/SCHEMA.md)
# DATABASE_URL="postgresql://aurelia:secret@localhost:5432/aurelia?schema=public"
# DIRECT_URL="postgresql://aurelia:secret@localhost:5432/aurelia?schema=public"

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Aurelia"
NEXT_PUBLIC_SUPPORT_EMAIL="concierge@aurelia.events"
NEXT_PUBLIC_SUPPORT_PHONE="+91 80000 40000"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

# ── Auth ────────────────────────────────────────────────────
# 32+ byte secret used to sign session JWTs and encrypt PII at rest.
AUTH_SECRET="dev-only-change-me-in-production-0000000000"
SESSION_TTL_DAYS="14"

# Google OAuth — leave blank to disable the Google button entirely.
# Enable at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ── Payments ────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY blank and the platform runs its built-in
# deterministic test gateway: identical split logic, ledger rows,
# invoices and payouts — no external calls.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_ACCOUNT_FEE_PERCENT="2"

# ── Storage ─────────────────────────────────────────────────
# Local filesystem adapter by default. Swap for S3/R2/GCS in prod.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./public/uploads"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ── Notifications ───────────────────────────────────────────
EMAIL_DRIVER="console"
EMAIL_FROM="Aurelia Concierge <concierge@aurelia.events>"
RESEND_API_KEY=""
SMS_DRIVER="off"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
WHATSAPP_ENABLED="false"

# ── Search ──────────────────────────────────────────────────
# "auto" → Postgres full-text when on Postgres, portable tokenised
# scoring otherwise. Force with "postgres" or "portable".
SEARCH_PROVIDER="auto"

# ── Observability ───────────────────────────────────────────
LOG_LEVEL="info"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"