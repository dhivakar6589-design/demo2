{
  "name": "aurelia",
  "version": "1.0.0",
  "private": true,
  "description": "Aurelia — a luxury multivendor marketplace for event management and catering.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:sqlite": "node scripts/prepare-dev-schema.mjs && prisma db push --accept-data-loss --schema=prisma/schema.dev.prisma --skip-generate && prisma generate --schema=prisma/schema.dev.prisma",
    "db:pg": "node scripts/prepare-prod-schema.mjs && prisma migrate dev --schema=prisma/schema.prod.prisma",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:seed": "node scripts/prepare-dev-schema.mjs && tsx prisma/seed.ts",
    "db:reset": "node scripts/prepare-dev-schema.mjs && prisma db push --force-reset --schema=prisma/schema.dev.prisma --skip-generate && prisma generate --schema=prisma/schema.dev.prisma && npm run db:seed",
    "db:studio": "node scripts/prepare-dev-schema.mjs && prisma studio --schema=prisma/schema.dev.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "1.2.11",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "framer-motion": "12.43.0",
    "jose": "6.0.11",
    "lucide-react": "0.545.0",
    "next": "15.5.27",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.2.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "stripe": "18.5.0",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/typography": "0.5.19",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.18.8",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "autoprefixer": "10.4.21",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
